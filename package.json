{
	"name": "sso-users-admin-panel-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "pnpm quality:check && tsc -b && vite build",
		"preview": "vite preview",
		"quality:check": "pnpm biome:check && pnpm check:unused && pnpm typescript:check",
		"biome:check": "pnpx @biomejs/biome check",
		"biome:fix": "pnpm biome:check --write",
		"check:unused": "pnpm knip",
		"typescript:check": "tsc -b",
		"test:unit": "vitest run --coverage src/features/*/tests/unit src/shared/tests/unit",
		"test:component": "vitest run --coverage src/shared/components src/features/*/components src/app/routes",
		"test:integrations": "vitest run --coverage src/features/*/tests/integrations",
		"test:accessibility": "playwright test --config=playwright.accessibility.config.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "pnpm test:e2e --ui"
	},
	"dependencies": {
		"@dhua5922/react-kit": "^3.0.1",
		"@hookform/resolvers": "^5.7.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-query-devtools": "^5.101.4",
		"axios": "^1.19.0",
		"js-ts-kit": "^1.1.0",
		"lucide-react": "^1.31.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.85.0",
		"react-router": "^8.3.0",
		"tailwindcss": "^4.3.3",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "2.5.7",
		"@playwright/test": "^1.62.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.4",
		"@vitest/coverage-v8": "4.1.10",
		"axe-core": "^4.13.0",
		"dotenv": "^17.4.2",
		"jsdom": "^30.0.1",
		"knip": "^6.31.0",
		"msw": "^2.15.0",
		"typescript": "~6.0.2",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	}
}
